# hush · Homebrew dependencies
# Installed by install.sh, or run: brew bundle install --file=Brewfile

brew "starship"                 # prompt
brew "zsh-autosuggestions"      # suggestions as you type
brew "zsh-syntax-highlighting"  # colors commands as you type
brew "fzf"                      # fuzzy finder
brew "zoxide"                   # smarter cd
brew "eza"                      # ls with icons and git status
brew "bat"                      # cat with syntax highlighting

cask "font-jetbrains-mono-nerd-font"
